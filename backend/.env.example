# backend/.env로 복사한 뒤 로컬에서 입력한다. DB 접속정보를 프론트엔드 VITE 변수에 넣지 않는다.
DB_HOST=YOUR_TIDB_HOST
DB_PORT=4000
DB_USER=YOUR_DB_USER
DB_PASSWORD=
DB_NAME=pikipick
# 절대 경로 또는 backend/ 기준 상대 경로를 사용한다. Windows에서는 슬래시(/)를 사용한다.
DB_SSL_CA=
DB_CONNECT_TIMEOUT=5
# 도서관 정보나루 Open API 인증키. 승인된 키를 backend/.env에만 입력한다.
DATA4LIBRARY_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
